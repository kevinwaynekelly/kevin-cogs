[
  {
    "name": "aria_template_preview",
    "action": "deployment_template_preview",
    "description": "Compare reviewed template XML to the saved template without writing; secret values stay redacted.",
    "properties": {
      "template": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "xml": {
        "type": "string",
        "maxLength": 131072
      },
      "expected_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "template",
      "xml",
      "expected_sha256"
    ],
    "read_only": true
  },
  {
    "name": "aria_template_history",
