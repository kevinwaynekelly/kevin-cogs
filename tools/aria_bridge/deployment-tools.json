  {
    "name": "aria_image_pin",
    "action": "deployment_image_pin",
    "description": "Pin a template to a verified locally available repository digest of the running image, retaining a backup. Does not deploy.",
    "properties": {
      "template": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "digest": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:\\-]*@sha256:[a-f0-9]{64}$",
        "maxLength": 600
      },
      "expected_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "template",
      "digest",
      "expected_sha256",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_container_policy",
    "action": "deployment_container_policy",
    "description": "Read the bridge policy for a container and its revision hash. Root scripts and external Unraid changes are outside this boundary.",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "name"
    ],
    "read_only": true
  },
  {
    "name": "aria_container_policy_save",
    "action": "deployment_container_policy_save",
    "description": "Replace a container bridge policy with optimistic concurrency. Explicitly configurable actions, update hold, UTC hours, stopped dependencies and Docker health requirements. Optional require_idle_profiles blocks changes while configured app activity is busy or unknown.",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "type": "array",
            "maxItems": 13,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "inspect",
                "logs",
                "start",
                "stop",
                "restart",
                "update",
                "deploy",
                "save",
                "restore",
                "pin",
                "test",
                "migrate",
                "exec"
              ]
            }
          },
          "hold_updates": {
            "type": "boolean"
          },
          "require_healthcheck": {
            "type": "boolean"
          },
          "health_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "maintenance_utc_hours": {
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            }
          },
          "require_stopped_containers": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "require_idle_profiles": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          }
        }
      },
      "expected_sha256": {
        "type": "string",
        "pattern": "^(?:[a-f0-9]{64})?$"
      },
      "request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "name",
      "policy",
      "expected_sha256",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_stack_save",
    "action": "deployment_stack_save",
    "description": "Save a reusable stack of reviewed template hashes and template dependencies; validates all members and rejects cycles.",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "template": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "expected_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "depends_on": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              },
              "required": [
                "template",
                "expected_sha256",
                "depends_on"
              ]
            }
          }
        },
        "required": [
          "members"
        ]
      },
      "expected_sha256": {
        "type": "string",
        "pattern": "^(?:[a-f0-9]{64})?$"
      },
      "request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "name",
      "definition",
      "expected_sha256",
      "request_id"
    ],
    "read_only": false
  },
