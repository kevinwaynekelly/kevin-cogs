        "maxLength": 128
      },
      "expected_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "template",
      "backup_id",
      "expected_sha256",
      "request_id"
    ],
    "read_only": false
  },
  {
