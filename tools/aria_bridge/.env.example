# Nonsecret deployment settings. Keep API keys and the Red token in files.
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_with_your_tunnel_id
ARIA_RED_URL=http://10.10.1.200:8766
ARIA_SECRET_DIR=/mnt/user/appdata/aria-gpt-bridge/secrets
ARIA_STATUS_DIR=/mnt/user/appdata/aria-gpt-bridge/status
# Host management is enabled by the installers. Compose users opt in with
# compose.management.yaml after starting host-service.sh and install-boot.
# The host state directory is root-only and is never mounted into the bridge.
