[
  {
    "name": "aria_file_roots",
    "action": "operations_file_roots",
    "description": "List managed host filesystem roots and size bounds. File operations reject symlinks and the bridge management state directory.",
    "properties": {},
    "required": [],
    "read_only": true
  },
  {
    "name": "aria_file_stat",
    "action": "operations_file_stat",
    "description": "Inspect a managed path and obtain a signature for a subsequent permission change.",
    "properties": {
      "path": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
      }
    },
    "required": [
      "path"
    ],
    "read_only": true
  },
  {
    "name": "aria_file_list",
    "action": "operations_file_list",
    "description": "List one directory page, without recursion or following symlinks. Filesystem ordering may change between calls.",
    "properties": {
      "path": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000,
        "default": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 100
      }
    },
    "required": [
      "path"
    ],
    "read_only": true
  },
  {
    "name": "aria_file_read",
    "action": "operations_file_read",
    "description": "Read a UTF8 managed text file up to 128 KiB. Output is limited to its last 64 KiB and known secrets are redacted. Private key and shadow files cannot be read. Hash covers original bytes, never edit redaction markers as if they were original values.",
    "properties": {
      "path": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
      }
    },
    "required": [
      "path"
    ],
    "read_only": true
  },
  {
    "name": "aria_host_exec",
    "action": "operations_host_exec",
    "description": "Queue a privileged root command as a literal argv array. First argument must be an absolute executable path; no implicit shell parsing occurs. Use script_save plus script_run_arguments for shell text. This can change the host; only use for the requested administration task. Output is bounded and redacted on a best-effort basis.",
    "properties": {
      "argv": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\x00]*$"
        },
        "minItems": 1
      },
      "working_directory": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
      },
      "secret_environment": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "secret_ref": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "required": [
            "environment",
            "secret_ref"
          ]
        }
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400,
        "default": 300
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "argv",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_container_exec",
    "action": "operations_container_exec",
    "description": "Queue a literal argv command inside an existing container, resolved to its immutable ID. First command argument must be an absolute executable path. Supports user, working directory and named secret environment references; rejects bridge self-execution. A timeout stops the Docker client; the command inside the container may continue and requires inspection.",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "argv": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\x00]*$"
        },
        "minItems": 1
      },
      "user": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
      },
      "working_directory": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
      },
      "secret_environment": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "secret_ref": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "required": [
            "environment",
            "secret_ref"
          ]
        }
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400,
        "default": 300
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "name",
      "argv",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_script_save",
    "action": "operations_script_save",
    "description": "Create or edit an installed Unraid User Script using expected SHA256. Validates Bash syntax, backs up the previous script and writes atomically; does not execute it. Store credentials separately and use named secret references.",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_. -]{0,127}$"
      },
      "script": {
        "type": "string",
        "maxLength": 131072,
        "pattern": "^[^\\x00]*$"
      },
      "expected_sha256": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(?:[a-f0-9]{64})?$",
        "description": "Expected existing SHA256; empty means the file must not exist."
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "name",
      "script",
      "expected_sha256",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_script_run_arguments",
    "action": "operations_script_run_arguments",
    "description": "Run exactly the installed User Script bytes identified by SHA256 with literal positional arguments and optional named secret environment references. Root execution uses the script directory and a bounded timeout.",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_. -]{0,127}$"
      },
      "expected_sha256": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-f0-9]{64}$"
      },
      "arguments": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\x00]*$"
        }
      },
      "secret_environment": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "secret_ref": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "required": [
            "environment",
            "secret_ref"
          ]
        }
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400,
        "default": 3600
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "name",
      "expected_sha256",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_secret_list",
    "action": "operations_secret_list",
    "description": "List named credential references and their opaque revisions. Secret values are never returned.",
    "properties": {},
    "required": [],
    "read_only": true
  },
  {
    "name": "aria_secret_import",
    "action": "operations_secret_import",
    "description": "Import or rotate a named secret from a managed host UTF8 file up to 16 KiB. Source hash prevents importing changed content; expected_revision is empty for a new name or the current revision when replacing it. Raw file bytes are preserved, including trailing newlines. Values are stored root-only and never returned.",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "source_path": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
      },
      "expected_source_sha256": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-f0-9]{64}$"
      },
      "expected_revision": {
        "type": "string",
        "maxLength": 32,
        "pattern": "^(?:[a-f0-9]{32})?$"
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "name",
      "source_path",
      "expected_source_sha256",
      "expected_revision",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_secret_delete",
    "action": "operations_secret_delete",
    "description": "Delete a named credential reference only if its revision still matches. Profiles referencing it will stop working until reconfigured.",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "expected_revision": {
        "type": "string",
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "name",
      "expected_revision",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_file_write",
    "action": "operations_file_write",
