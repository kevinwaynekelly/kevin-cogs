  {
    "name": "aria_file_permissions",
    "action": "operations_file_permissions",
    "description": "Change permissions and optionally numeric owner/group for one managed file or directory, only if its stat signature matches. Never recursive. Mode is a four-digit octal string without special bits.",
    "properties": {
      "path": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
      },
      "expected_signature": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-f0-9]{64}$"
      },
      "mode": {
        "type": "string",
        "maxLength": 4,
        "pattern": "^0[0-7]{3}$"
      },
      "uid": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "gid": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "path",
      "expected_signature",
      "mode",
      "request_id"
    ],
    "read_only": false
  },
