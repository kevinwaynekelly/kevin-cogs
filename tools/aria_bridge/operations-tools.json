  {
    "name": "aria_archive_restore",
    "action": "operations_archive_restore",
    "description": "Restore configuration files from a verified archive, after checking the current complete inventory hash. Backs up current configuration first and attempts rollback on write failure. overwrite must be true to replace different existing files. Does not deploy containers, remove extra files, or restore changed bridge templates.",
