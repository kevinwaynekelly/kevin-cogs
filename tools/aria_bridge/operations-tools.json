      "expected_sha256": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(?:[a-f0-9]{64})?$",
        "description": "Expected existing SHA256; empty means the file must not exist."
      },
      "request_id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "required": [
      "path",
      "content",
      "expected_sha256",
      "request_id"
    ],
    "read_only": false
  },
  {
    "name": "aria_file_mkdir",
    "action": "operations_file_mkdir",
    "description": "Create exactly one managed directory with an existing parent. Does not overwrite an existing path.",
    "properties": {
      "path": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^/[^\\x00-\\x1f\\x7f]+$"
